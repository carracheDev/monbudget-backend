# Neon PostgreSQL connection string:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/monbudget_db?sslmode=require"
# Local PostgreSQL example: postgresql://postgres:motdepasse123@localhost:5432/monbudget_db
PORT=3000
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# Authentication and third-party services used by the related modules.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_ENCRYPTION_KEY=""